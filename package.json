{
  "name": "yaml-editor",
  "version": "0.1.0",
  "description": "Editor web ligero de YAML con formularios desde JSON Schema",
  "main": "index.js",
  "bin": {
    "make-me-yaml": "bin/make-me-yaml.js"
  },
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "test": "node --test test/api.test.mjs test/format.test.mjs test/workspace.test.mjs test/cli.test.mjs",
    "start": "node server.js",
    "test:e2e": "node test/e2e.mjs && node test/motion.e2e.mjs",
    "animations:generate": "node scripts/generate-animations.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && wails dev",
    "desktop:build": "npm run desktop:prepare && wails build -s",
    "test:desktop": "node test/desktop.e2e.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lottie-web": "5.13.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=20"
  }
}
